{
  "expo": {
    "name": "Loudnight Door",
    "slug": "loudnight-door",
    "scheme": "loudnight-door",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "backgroundColor": "#120e0c",
    "ios": {
      "bundleIdentifier": "app.loudnight.door",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Loudnight uses the camera to scan tickets at the door."
      }
    },
    "android": {
      "package": "app.loudnight.door",
      "permissions": ["CAMERA"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#120e0c"
      },
      "blockedPermissions": ["android.permission.RECORD_AUDIO"]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Loudnight uses the camera to scan tickets at the door.",
          "recordAudioAndroid": false
        }
      ],
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "5d8167f3-970f-488e-8855-0149d0f6a631"
      }
    },
    "owner": "wamasoda"
  }
}
