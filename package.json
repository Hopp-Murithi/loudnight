{
  "name": "encore",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "validate": "npm run check:dashes && npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build",
    "check:dashes": "node scripts/check-dashes.mjs",
    "check:connections": "node --env-file=.env.local scripts/check-connections.ts",
    "db:types": "supabase gen types typescript --local > src/types/database.ts && prettier --write src/types/database.ts",
    "db:types:linked": "supabase gen types typescript --linked > src/types/database.ts && prettier --write src/types/database.ts",
    "db:test": "node scripts/run-db-tests.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@base-ui/react": "1.8.0",
    "@hookform/resolvers": "5.9.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "@tanstack/react-query": "5.104.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "lucide-react": "1.48.0",
    "next": "16.3.6",
    "next-themes": "0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.89.0",
    "server-only": "0.0.1",
    "shadcn": "4.21.0",
    "sonner": "2.0.8",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "jsdom": "29.1.1",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
